# 1. DECORATOR
def hitung_waktu(func):
    def wrapper(*args, **kwargs):
        start = time.time()
        result = func(*args, **kwargs)
        end = time.time()
        selisih = end - start
        print ("Waktu berjalannya kode adalah : ",selisih)
        return result
    return wrapper

